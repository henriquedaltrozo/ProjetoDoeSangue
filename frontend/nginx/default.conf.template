# Template processado pela imagem oficial do nginx na subida do container: ${API_ORIGIN} é trocado
# pelo valor da variável de ambiente (ver Dockerfile). Variáveis do próprio nginx ($uri, $csp...)
# não são variáveis de ambiente, então ficam intactas.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  # Content-Security-Policy: o app só carrega código, estilos e imagens do próprio site e só
  # conversa por rede com ele e com o gateway (API_ORIGIN).
  set $csp "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";

  gzip on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Arquivos gerados pelo Vite têm hash no nome: nunca mudam, então podem ficar em cache por 1 ano.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA: qualquer rota que não seja um arquivo estático cai no index.html, deixando o
  # react-router-dom decidir a tela. O index.html não fica em cache, para cada deploy
  # novo chegar ao navegador na hora.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
