# Ambiente
NODE_ENV=development

# Portas HTTP de cada serviço (mesmos valores usados dentro do Docker
# Compose - ver docker-compose.yml na raiz do repositório). notification-service
# continua sendo majoritariamente um worker BullMQ, mas agora expõe uma
# porta HTTP só para o endpoint /health (ver docs/05-observability.md).
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
ELIGIBILITY_SERVICE_PORT=3002
SCHEDULING_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004

# JWT (segredo compartilhado entre gateway/serviços para validar token sem
# chamada extra ao auth-service)
JWT_SECRET=troque-este-segredo-em-producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL - um banco e um usuário por serviço (ver infra/postgres/init-databases.sh).
# DB_* são o padrão; cada serviço pode sobrescrever com <SCHEMA>_DB_* (AUTH_, ELIGIBILITY_,
# SCHEDULING_, NOTIFICATION_). Em desenvolvimento local um único banco também funciona.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=doesangue
# DB_SYNCHRONIZE=true  # troca as migrations pelo synchronize do TypeORM (só para experimentar localmente)
# AUTH_DB_DATABASE=auth_db
# AUTH_DB_USERNAME=auth_svc
# AUTH_DB_PASSWORD=auth_svc
# (idem para ELIGIBILITY_, SCHEDULING_ e NOTIFICATION_)

# Segurança
# Origens do front aceitas no CORS (lista separada por vírgulas); padrão: FRONTEND_URL
CORS_ORIGINS=http://localhost:5173
# Token exigido (header x-setup-token) para criar o PRIMEIRO admin via POST /auth/admin.
# Sem ele o bootstrap fica fechado. Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SETUP_TOKEN=troque-este-token-de-instalacao
# Cookie httpOnly do refresh token: SameSite (strict|lax|none) e Secure (padrão: true em produção).
# Com front e API em sites diferentes use COOKIE_SAMESITE=none (exige HTTPS).
# COOKIE_SAMESITE=strict
# COOKIE_SECURE=false
# Proxies confiáveis na frente do serviço (o auth já assume 1: o gateway)
# TRUST_PROXY_HOPS=1

# Com NODE_ENV=production, o serviço se recusa a subir com segredos de exemplo ("troque-..."),
# com JWT_SECRET/INTERNAL_API_KEY com menos de 32 caracteres ou com DATA_ENCRYPTION_KEY fora do
# formato de 32 bytes. O docker-compose local liga a liberação abaixo; nunca use num ambiente real.
# ALLOW_INSECURE_DEFAULT_SECRETS=true

# Despachante do outbox do scheduling-service (true por padrão)
OUTBOX_DISPATCHER_ENABLED=true

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# URLs internas para comunicacao REST sincrona entre servicos
# (SCHEDULING_SERVICE_URL também é usada pelo eligibility, no aviso "já pode doar")
AUTH_SERVICE_URL=http://localhost:3001
ELIGIBILITY_SERVICE_URL=http://localhost:3002
SCHEDULING_SERVICE_URL=http://localhost:3003
# Usada pelo gateway (tela E-mails do admin, webhook do provedor).
NOTIFICATION_SERVICE_URL=http://localhost:3004

# Chave compartilhada para chamadas servico-a-servico em endpoints internos
# (ex: auth-service -> eligibility-service ao criar o Doador no cadastro)
INTERNAL_API_KEY=troque-esta-chave-interna-em-producao

# Chave (32 bytes em hex) usada para cifrar em repouso colunas sensíveis
# do eligibility-service (tipo sanguíneo, peso, altura, motivos de
# inaptidão) - ver encryptedColumn em libs/shared-config. Gere uma nova em
# produção com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=19942c59da09edd2741cfe75e3dba8f1cee57dda23bfd6a5f2f27091693f5e81

# E-mail (SMTP, via Nodemailer no notification-service - qualquer provedor com SMTP).
# - Com o docker-compose e sem nada definido aqui: os e-mails vão para o Mailpit, uma caixa de
#   teste local; abra http://localhost:8025 para vê-los. Nada sai para a internet.
# - Rodando os serviços fora do Docker com SMTP_HOST vazio: o envio é só simulado (vai para o log).
# - Envio real: descomente e preencha. Exemplo com o Brevo (plano gratuito de 300 e-mails/dia):
#   em brevo.com, crie a conta, verifique o remetente (Senders) e gere uma chave em
#   SMTP & API > SMTP. O SMTP_USER é o "login" mostrado nessa tela.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false          # 'true' só para a porta 465 (TLS direto)
# SMTP_USER=seu-login@smtp-brevo.com
# SMTP_PASSWORD=sua-chave-smtp
# MAIL_FROM="DoeSangue <o-remetente-verificado@seu-dominio.com>"
# Máximo de e-mails por segundo (o padrão 5 cabe nos planos gratuitos). Atenção: é lida do
# ambiente do processo, não deste arquivo. No docker-compose ela já é repassada; rodando o
# notification-service fora do Docker, exporte-a antes (ex.: MAIL_RATE_PER_SECOND=10 pnpm start).
# MAIL_RATE_PER_SECOND=5
# Webhook de devoluções e spam do provedor (no Brevo: Transactional > Settings > Webhook, eventos
# "Hard bounce", "Blocked", "Invalid email" e "Spam"), com a URL
# https://<sua-api>/notifications/webhooks/mail?token=<este segredo>. Vazio = webhook desligado.
# MAIL_WEBHOOK_SECRET=
# URL pública da API (o gateway): usada no botão "cancelar inscrição" do Gmail/Outlook.
# PUBLIC_API_URL=http://localhost:3000
# Aviso diário "você já pode doar" (eligibility, a partir das 8h de Brasília). false = desligado.
# ELIGIBLE_AGAIN_JOB_ENABLED=true

# Base do front, usada nos links dos e-mails (confirmação de e-mail, redefinição de senha,
# confirmação de presença, agendar, meus agendamentos, perfil) - ver docker-compose.yml (porta 5173 do front).
FRONTEND_URL=http://localhost:5173
